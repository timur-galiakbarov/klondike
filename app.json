{
  "expo": {
    "name": "Пасьянс Косынка",
    "slug": "klondike",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/game-icon-7.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f2a1f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.timurgaliakbarov.klondike",
      "googleServicesFile": "./config/GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserTrackingUsageDescription": "Мы используем данные устройства, чтобы показывать более релевантную рекламу и поддерживать бесплатную версию приложения.",
        "SKAdNetworkItems": [
          {
            "SKAdNetworkIdentifier": "zq492l623r.skadnetwork"
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f2a1f"
      },
      "package": "com.timurgaliakbarov.klondike",
      "permissions": [
        "AD_ID"
      ],
      "googleServicesFile": "./config/google-services.json"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "FirebaseCoreInternal",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "analytics": true
          },
          "android": {
            "analytics": true
          }
        }
      ],
      "expo-audio",
      "expo-tracking-transparency"
    ],
    "extra": {
      "appMetricaKey": "e56e3eca-1b63-4f52-8acf-b55afa0f0413",
      "eas": {
        "projectId": "963d6471-07ac-4efe-abbd-4016867053d4"
      }
    }
  }
}
