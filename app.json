{
  "expo": {
    "name": "Пасьянс Косынка",
    "slug": "klondike",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/game-icon-7.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f2a1f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.timurgaliakbarov.klondike",
      "googleServicesFile": "./config/GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f2a1f"
      },
      "package": "com.timurgaliakbarov.klondike",
      "googleServicesFile": "./config/google-services.json"
    },
    "plugins": [
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "analytics": true
          },
          "android": {
            "analytics": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "963d6471-07ac-4efe-abbd-4016867053d4"
      }
    }
  }
}
